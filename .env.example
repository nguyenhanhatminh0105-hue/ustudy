# Copy to .env and adjust. Every value is optional in development.

# PORT=3000

# Leave unset to use the embedded PGlite database (stored in .data/pglite).
# Or point at any PostgreSQL 14+:
# DATABASE_URL=postgres://ustudy:change-me@localhost:5432/ustudy

# Required in production: a long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=

# Seed sample accounts into an empty database (default: true outside production).
# SEED_DEMO=true

# Number of reverse proxies in front of the server. 0 when you run it directly;
# 1 on hosts such as Render, so rate limits see each visitor's own address.
# TRUST_PROXY=0

# On a public deploy the sample admin account is locked, because its default
# password is in the README. Set this to sign in as admin@ustudy.app there.
# DEMO_ADMIN_PASSWORD=
