{
  "name": "ustudy",
  "version": "2.0.0",
  "private": true,
  "description": "A study companion that grows up with you: assignments, focus sessions, habits and realtime study rooms, with a 3D companion that evolves from baby to adult as you get work done.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "seed": "node server/db/seed.js",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "bcrypt": "^6.0.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/zen-kaku-gothic-new": "^5.3.1",
    "@fontsource/zen-maru-gothic": "^5.3.1",
    "lucide": "^1.59.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "three": "^0.186.1",
    "vite": "^8.3.4"
  }
}
